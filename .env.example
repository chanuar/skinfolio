# Copia este archivo como `.env` para desarrollo local y configura las mismas
# variables en Cloudflare. La clave publicable es pública por diseño: RLS limita
# los datos de la colección que puede leer el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# No añadas una service-role key ni credenciales del collector.
# Se conserva VITE_SUPABASE_ANON_KEY solo como compatibilidad con proyectos antiguos.
